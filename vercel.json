{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/news/article\\.html$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(facebookexternalhit|Facebot|Twitterbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Discordbot|Pinterestbot|Zalo|SkypeUriPreview|Google-InspectionTool|Googlebot)"
        }
      ],
      "dest": "/api/social-meta"
    },
    {
      "handle": "filesystem"
    }
  ]
}
